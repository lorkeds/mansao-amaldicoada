# Copie este arquivo para .env (ou configure no painel do Render).
# NUNCA coloque senhas reais neste arquivo de exemplo.

# Sem DATABASE_URL o jogo usa SQLite local (database/mansao.db).
# Com ela, usa PostgreSQL. Formato:
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Porta do servidor (o Render define sozinho)
PORT=5000

# 1 = mostra erros detalhados (só para desenvolvimento)
FLASK_DEBUG=0
